{
  "name": "open-botc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, storyteller-free Blood on the Clocktower (Trouble Brewing) for in-person play with phones",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
